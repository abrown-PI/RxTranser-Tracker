{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/14c4fb10-085e-4ac6-a5b3-d49f57a97731/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    { "route": "/api/healnow-webhook",   "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/fedex-auto-match",  "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/send-daily-summary","allowedRoles": ["anonymous", "authenticated"] },

    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/*",     "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
